            <ui:VisualElement name="xp-panel" style="flex-grow: 1; width: 69%; height: 19%; position: absolute; top: 25px; left: 57px;">
                <ui:ProgressBar value="100" title="" name="xp-bar" style="-unity-background-image-tint-color: rgb(255, 255, 255); width: 372px; height: 44px; top: 3%; left: 21%; position: absolute; color: rgb(255, 255, 255); background-image: url(&quot;project://database/Assets/Materials/Sprite/game_ui/xpborder.png?fileID=2800000&amp;guid=e71a315bbd137e44e9090d7d7ae8e5fa&amp;type=3#xpborder&quot;); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgb(231, 208, 85); border-bottom-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;"/>
                <ui:VisualElement name="Panel_Level" data-source="project://database/Assets/Game%20Data/Player/MainPlayer.asset?fileID=11400000&amp;guid=ca34b324d0584cf49adaf5835d723bc8&amp;type=2#MainPlayer" style="flex-grow: 1; top: -5%; left: 32%; right: auto; bottom: 0; width: 314px; height: 0; flex-basis: auto; align-items: flex-start; justify-content: flex-start; align-self: stretch; flex-direction: row;">
