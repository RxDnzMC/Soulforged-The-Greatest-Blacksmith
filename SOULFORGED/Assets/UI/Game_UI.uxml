                <ui:Label text="0" name="GoldTextTop" data-source="project://database/Assets/Game%20Data/Player/MainPlayer.asset?fileID=11400000&amp;guid=ca34b324d0584cf49adaf5835d723bc8&amp;type=2#MainPlayer" style="font-size: 24px; color: rgb(255, 215, 0); -unity-font-style: bold; text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="gold" binding-mode="ToTarget"/>
