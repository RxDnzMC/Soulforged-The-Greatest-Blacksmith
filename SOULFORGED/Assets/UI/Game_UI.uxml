        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Pause" enabled="true" style="flex-grow: 1; position: absolute; height: 100%; width: 100%; color: rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0.63); align-content: flex-start; align-self: auto; align-items: stretch; justify-content: center; visibility: visible; display: none;">
        <ui:VisualElement name="Pause_Menu" class="container" style="flex-grow: 0; background-size: 50% 50%; align-items: center; justify-content: center; align-self: center; width: 25%; height: 75%; flex-shrink: 0; padding-top: 17px; padding-right: 17px; padding-bottom: 17px; padding-left: 17px; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-left-color: rgb(42, 89, 35); border-right-color: rgb(42, 89, 35); border-top-color: rgb(42, 89, 35); border-bottom-color: rgb(42, 89, 35); display: flex; visibility: visible;">
            <ui:Label text="Game Paused" name="Pause_Label" style="color: rgb(255, 255, 255); font-size: 42%; margin-top: -3%; margin-right: 4%; margin-bottom: 9%; margin-left: 2%; width: 70%; height: 10%; justify-content: center; align-self: center; align-content: center; align-items: center; -unity-text-align: middle-center; white-space: normal; text-overflow: ellipsis; text-shadow: 0 0 0 rgb(56, 56, 56); -unity-text-auto-size: none;"/>
            <ui:Button text="Resume" name="Resume_Button" class="pausemenu-button"/>
            <ui:Button text="Restart" name="Restart_Button" class="pausemenu-button" style="background-position-x: center;"/>
            <ui:Button text="Exit" name="Exit_Button" class="pausemenu-button"/>
