    <ui:VisualElement name="GameOverPanel" enabled="true" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.85); justify-content: center; align-items: center; display: none; top: 0; left: -3px; visibility: visible;">
        <ui:VisualElement class="gameover-container" style="background-color: rgba(157, 119, 49, 0.95); border-width: 3px; border-color: rgb(255, 215, 0); border-radius: 20px; padding: 40px; align-items: center; width: 500px; border-left-color: rgb(255, 236, 125); border-right-color: rgb(255, 236, 125); border-top-color: rgb(255, 236, 125); border-bottom-color: rgb(255, 236, 125);">
            <ui:Label text="GAME SELESAI!" name="GameOverTitle" style="font-size: 48px; color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 30px; text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);"/>
            <ui:Label text="Waktu: 00:00" name="GameOverTimer" style="font-size: 24px; color: white; margin-bottom: 20px;"/>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 15px;">
                <ui:Image name="GoldIcon" style="width: 35px; height: 35px; margin-right: 10px; background-image: url(&quot;project://database/Assets/Icon/coinsprite1.png?fileID=2800000&amp;guid=30158d2310910184389c707eaf7ac022&amp;type=3#coinsprite1&quot;); right: 30px;"/>
                <ui:Label text="Gold: 0" name="GameOverGold" style="font-size: 28px; color: rgb(255, 215, 0); -unity-font-style: bold; right: 30px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 30px;">
                <ui:Image name="SoulIcon" style="width: 45px; height: 45px; margin-right: 10px; background-image: url(&quot;project://database/Assets/Icon/SolFirecompact.png?fileID=2800000&amp;guid=d7f469b560d34fb49b7b4fb9c3f9b12d&amp;type=3#SolFirecompact&quot;); right: 25px;"/>
                <ui:Label text="Souls: 0" name="GameOverSouls" style="font-size: 28px; color: rgb(150, 200, 255); -unity-font-style: bold; align-self: auto; justify-content: flex-start; align-items: stretch; right: 30px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="height: 2px; width: 80%; background-color: rgb(255, 215, 0); margin-bottom: 30px;"/>
            <ui:Label text="Player Sekarang Memiliki:" name="GameOverTotalLabel" style="font-size: 20px; color: rgb(200, 200, 200); margin-bottom: 10px;"/>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 80%; margin-bottom: 30px;">
                <ui:Label text="Gold: 0" name="GameOverTotalGold" style="font-size: 22px; color: rgb(255, 215, 0);"/>
                <ui:Label text="Souls: 0" name="GameOverTotalSouls" style="font-size: 22px; color: rgb(150, 200, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: center;">
                <ui:Button text="EXIT GAME" name="ExitGameButton" class="gameover-button" style="margin-right: 10px; background-image: url(&quot;project://database/Assets/Materials/Sprite/buttonLong_beige.png?fileID=2800000&amp;guid=d4b898bcfb742b84ca40ab0e1b6441c1&amp;type=3#buttonLong_beige&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
