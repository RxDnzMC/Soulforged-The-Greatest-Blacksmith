        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Panel_Timer" data-source="project://database/Assets/Game%20Data/Player/MainPlayer.asset?fileID=11400000&amp;guid=ca34b324d0584cf49adaf5835d723bc8&amp;type=2#MainPlayer" style="flex-grow: 0; top: 0; left: 856px; right: auto; bottom: 0; width: 215px; height: 82px; flex-basis: 99%; align-items: flex-start; justify-content: flex-start; align-self: stretch; flex-direction: row; flex-shrink: 0;">
        <ui:Label text="00:00" name="Timer" style="-unity-font-style: normal; font-size: 64px; width: 179px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Pause" enabled="true" style="flex-grow: 1; position: absolute; height: 100%; width: 100%; color: rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0.63); align-content: flex-start; align-self: auto; align-items: stretch; justify-content: center; visibility: visible; display: none;">
        <ui:VisualElement name="Pause_Menu" class="container" style="flex-grow: 0; background-size: 50% 50%; align-items: center; justify-content: flex-start; align-self: center; width: 25%; height: 75%; flex-shrink: 0; padding-top: 17px; padding-right: 17px; padding-bottom: 17px; padding-left: 17px; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-left-color: rgb(42, 89, 35); border-right-color: rgb(42, 89, 35); border-top-color: rgb(42, 89, 35); border-bottom-color: rgb(42, 89, 35);">
            <ui:Label text="Game Paused" name="Pause_Label" style="color: rgb(255, 255, 255); font-size: 32px;"/>
            <ui:Button text="Resume" name="Resume_Button" class="pausemenu-button"/>
            <ui:Button text="Restart" name="Restart_Button" class="pausemenu-button" style="background-position-x: center;"/>
            <ui:Button text="Exit" name="Exit_Button" class="pausemenu-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
