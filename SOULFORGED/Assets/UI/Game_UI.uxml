            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Image name="SoulIconTop" scale-mode="ScaleToFit" style="width: 45px; height: 45px; margin-right: 8px; background-image: url(&quot;project://database/Assets/Icon/SolFirecompact.png?fileID=2800000&amp;guid=d7f469b560d34fb49b7b4fb9c3f9b12d&amp;type=3#SolFirecompact&quot;); -unity-background-scale-mode: stretch-to-fill; -unity-slice-scale: 234px;"/>
                <ui:Label text="0" name="SoulTextTop" data-source="project://database/Assets/Game%20Data/Player/MainPlayer.asset?fileID=11400000&amp;guid=ca34b324d0584cf49adaf5835d723bc8&amp;type=2#MainPlayer" style="font-size: 24px; color: rgb(150, 200, 255); -unity-font-style: bold; text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.5);">
