            <ui:VisualElement name="HP_BORDER" style="flex-grow: 0; -unity-material: url(&quot;&quot;); background-color: rgba(255, 255, 255, 0); flex-shrink: 0; width: 47%; height: 83%; background-image: url(&quot;project://database/Assets/Materials/Sprite/game_ui/hpborder.png?fileID=2800000&amp;guid=05238ab7b6187d149af6f23231a885ce&amp;type=3#hpborder&quot;); position: relative; top: -8%; left: -7%; flex-direction: column-reverse; align-items: center; justify-content: space-around; align-self: flex-start; background-size: 72% 72%;">
