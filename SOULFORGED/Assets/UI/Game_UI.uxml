    <ui:VisualElement name="AllPanel" style="flex-grow: 1; flex-direction: row; width: 100%; height: 100%; display: flex;">
        <ui:VisualElement name="Panel_Timer" data-source="project://database/Assets/Game%20Data/Player/MainPlayer.asset?fileID=11400000&amp;guid=ca34b324d0584cf49adaf5835d723bc8&amp;type=2#MainPlayer" style="flex-grow: 0; top: auto; left: auto; right: 45%; bottom: auto; width: 10%; height: 10%; flex-basis: 12%; align-items: flex-start; justify-content: flex-end; align-self: flex-start; flex-direction: row; flex-shrink: 0; position: absolute; flex-wrap: nowrap; align-content: flex-start;">
            <ui:Label text="00:00" name="Timer" style="-unity-font-style: normal; font-size: 64px; width: 179px; text-shadow: -1.9px 7.7px 0 rgba(0, 0, 0, 0.32);"/>
        </ui:VisualElement>
        <ui:VisualElement name="CurrencyPanel" style="flex-grow: 0; position: absolute; top: 15px; right: 30px; flex-direction: row; align-items: center; justify-content: flex-end; background-color: rgba(0, 0, 0, 0.5); border-radius: 10px; padding: 10px 20px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 25px;">
