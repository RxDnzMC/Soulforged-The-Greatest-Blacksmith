:root {
}

.container {
    background-color: rgb(15, 34, 12);
}

.pausemenu-button {
    width: 83%;
    height: 14%;
    margin-top: 10%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    font-size: 300%;
    background-color: rgb(29, 60, 34);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-top: 10%;
    padding-bottom: 10%;
}

.pausemenu-button:hover {
    width: 83%;
    height: 69px;
    margin-top: 10%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    font-size: 450%;
    color: rgb(0, 0, 0);
    background-color: rgb(73, 111, 79);
    scale: 1 1;
    translate: 0% 0%;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
    rotate: 1deg;
    transition-duration: 0.1s;
    transform-origin: center;
    padding-top: 10%;
    padding-bottom: 10%;
}

.unity-progress-bar__progress {
    background-color: rgb(79, 255, 0);
    height: 32px;
    flex-shrink: 0;
}

.unity-progress-bar__background {
    -unity-background-image-tint-color: rgb(0, 0, 0);
    background-color: rgb(34, 111, 23);
    flex-shrink: 0;
    height: 39px;
}

.unity-progress-bar__title-container {
    display: none;
}

.font-normal {
    -unity-font-style: bold;
    font-size: 64px;
}
