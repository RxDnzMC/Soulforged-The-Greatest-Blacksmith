:root {
}

.container {
    background-color: rgb(15, 34, 12);
}

.pausemenu-button {
    width: 83%;
    height: 14%;
    margin-top: 10%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    font-size: 450%;
    background-color: rgb(29, 60, 34);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-top: 10%;
    padding-bottom: 10%;
    background-image: url("project://database/Assets/Materials/Sprite/buttonLong_beige.png?fileID=2800000&guid=d4b898bcfb742b84ca40ab0e1b6441c1&type=3#buttonLong_beige");
    -unity-background-image-tint-color: rgb(255, 200, 144);
    -unity-font-style: bold;
}

.pausemenu-button:hover {
    width: 83%;
    height: 14%;
    margin-top: 10%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    font-size: 550%;
    color: rgb(0, 0, 0);
    background-color: rgba(73, 111, 79, 0);
    scale: 1 1;
    translate: 0% 0%;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
    rotate: 1deg;
    transition-duration: 0.1s;
    transform-origin: center;
    padding-top: 10%;
    padding-bottom: 10%;
    -unity-font-style: bold;
    -unity-background-image-tint-color: rgb(255, 220, 164);
    background-image: url("project://database/Assets/Materials/Sprite/buttonLong_beige.png?fileID=2800000&guid=d4b898bcfb742b84ca40ab0e1b6441c1&type=3#buttonLong_beige");
}

.unity-progress-bar__progress {
    background-color: rgba(255, 255, 255, 0);
    height: 39px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Materials/Sprite/game_ui/xpfull.png?fileID=2800000&guid=fa8d4713f10dc6643a1e77582d7abda1&type=3#xpfull");
    top: -3px;
    bottom: 400px;
    width: auto;
    right: auto;
    background-position-x: left 3px;
    background-position-y: top -1px;
}

.unity-progress-bar__background {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0);
    flex-shrink: 0;
    height: 39px;
    background-image: url("project://database/Assets/Materials/Sprite/game_ui/xpempty.png?fileID=2800000&guid=c27b33089ef55da449c956f833cea4ce&type=3#xpempty");
    scale: 1 1;
    transform-origin: left;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    right: 3px;
    width: 370px;
}

.unity-progress-bar__title-container {
    display: none;
}

.font-normal {
    -unity-font-style: bold;
    font-size: 64px;
}

.upgrade-choice {
    width: 280px;
    background-color: rgba(20, 25, 40, 0.95);
    border-width: 3px;
    border-color: rgb(100, 100, 100);
    border-radius: 15px;
    margin: 15px;
    padding: 25px 20px;
    align-items: center;
    transition: border-color 0.2s, background-color 0.2s, scale 0.15s;
}

.upgrade-choice:hover {
    border-color: rgb(255, 215, 0);
    background-color: rgba(30, 35, 55, 0.95);
    scale: 1.03;
}

.upgrade-choice Image {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(80, 80, 80);
}

.upgrade-choice:hover Image {
    border-color: rgb(255, 215, 0);
}

.upgrade-button {
    background-color: rgb(50, 50, 50);
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    width: 100%;
    height: 45px;
    margin-top: 5px;
    transition: background-color 0.2s, border-color 0.2s;
}

.upgrade-button:hover {
    background-color: rgb(255, 215, 0);
    color: black;
    border-color: rgb(255, 200, 0);
}
