:root {
}

/* ========== STYLE LAMA (TETEP) ========== */

.container {
    background-color: rgb(15, 34, 12);
}

.pausemenu-button {
    width: 83%;
    height: 14%;
    margin-top: 10%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    font-size: 300%;
    background-color: rgb(29, 60, 34);
    color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    padding-top: 10%;
    padding-bottom: 10%;
}

.pausemenu-button:hover {
    width: 83%;
    height: 69px;
    margin-top: 10%;
    margin-right: 0%;
    margin-bottom: 10%;
    margin-left: 0%;
    font-size: 450%;
    color: rgb(0, 0, 0);
    background-color: rgb(73, 111, 79);
    scale: 1 1;
    translate: 0% 0%;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
    rotate: 1deg;
    transition-duration: 0.1s;
    transform-origin: center;
    padding-top: 10%;
    padding-bottom: 10%;
}

.unity-progress-bar__progress {
    background-color: rgb(79, 255, 0);
    height: 32px;
    flex-shrink: 0;
}

.unity-progress-bar__background {
    -unity-background-image-tint-color: rgb(0, 0, 0);
    background-color: rgb(34, 111, 23);
    flex-shrink: 0;
    height: 39px;
}

.unity-progress-bar__title-container {
    display: none;
}

.font-normal {
    -unity-font-style: bold;
    font-size: 64px;
}

/* ========== STYLE UPGRADE PANEL (BARU) ========== */

.upgrade-choice {
    width: 280px;
    background-color: rgba(20, 25, 40, 0.95);
    border-width: 3px;
    border-color: rgb(100, 100, 100);
    border-radius: 15px;
    margin: 15px;
    padding: 25px 20px;
    align-items: center;
    transition: border-color 0.2s, background-color 0.2s, scale 0.15s;
}

.upgrade-choice:hover {
    border-color: rgb(255, 215, 0);
    background-color: rgba(30, 35, 55, 0.95);
    scale: 1.03;
}

.upgrade-choice Image {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(80, 80, 80);
}

.upgrade-choice:hover Image {
    border-color: rgb(255, 215, 0);
}

.upgrade-button {
    background-color: rgb(50, 50, 50);
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    width: 100%;
    height: 45px;
    margin-top: 5px;
    transition: background-color 0.2s, border-color 0.2s;
}

.upgrade-button:hover {
    background-color: rgb(255, 215, 0);
    color: black;
    border-color: rgb(255, 200, 0);
}